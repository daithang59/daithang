extends ./views/layout/_dashboard
append stylesheet
    link(rel="stylesheet", href="./styles/trending.css") 
block title 
    title GoCastUI - Trending
block main
    .trendingpage
        .trendingpage-header 
            h1.trendingpage-header-title Trending Podcast 
            .trendingpage-thumbnail 
                +thumbnailItem
            .trendingpage-dot 
                img(src= "./images/trending/_img-dot.svg", alt="dot")
            .trendingpage-button-list 
                +buttonNone("All")
                +buttonNone("Shows")
                button.button.button--primary.button-trendingpage 
                    span Episodes
        .trendingpage-main 
            .trendingpage-main-header
                +HeaderItem("Trending Episodes", "The Most Popular Podcast episodes overall now. Last updated 2 hours ago", "Last 1 Weeks")
