mixin menuItem(text,icon= '' ,href= "#")
    li.menu-item
        a.menu-link(href= href) 
            span.menu-icon 
                if icon
                    case icon   
                        when 'icon-home'
                            include ../icons/_icon-home
                        when 'icon-3dcube'
                            include ../icons/_icon-3dcube
                        when 'icon-3user'
                            include ../icons/_icon-3user
                        when 'icon-adduser'
                            include ../icons/_icon-adduser
                        when 'icon-chart'
                            include ../icons/_icon-chart
                        when 'icon-discovery'
                            include ../icons/_icon-discovery
                        when 'icon-microphone-2'
                            include ../icons/_icon-microphone-2
                        when 'icon-play'
                            include ../icons/_icon-play
                        when 'icon-star'
                            include ../icons/_icon-star
                        when 'icon-subscriptions'
                            include ../icons/_icon-subscriptions
            span.menu-text= text

mixin toggle()
    label.toggle
        input(type="checkbox", name="")    
        .toggle-main
            .toggle-spinner 

mixin button(icon= false, title = "Play Episode")    
    button.button.button--primary 
        if icon 
            include ../icons/_icon-play-button
        span= title

mixin feedItem(avt = "../../images/host-users/img-host-user6.png", name = "James Killened", rated = "rated an episude",icon = true, username = "Jun 25th", thumb = "../../images/feed-img/_img1.svg", toptitle = "Perspective Podcast (Ep. 1)", title = "Philosophy vs Religion vs Science: Yahia Amin and Sadman Sadik", content = "Play Philosophy vs Religion vs Science: Perspective Podcast (Ep. 1) | Yahia Amin and Sadman Sadik by PERSPECTIVE with Yahia Amin on desktop and mobile. Play over 265 million tracks for...")
    .feed-item  
        .feed-item-header 
            .feed-author 
                .feed-author-avatar 
                    img(src= avt, alt="")
                    span.feed-author-verify    
                        include ../icons/_icon-verify
                .feed-author-content 
                    .feed-author-header
                        h4.feed-author-name= name
                        .feed-author-rating 
                            span= rated
                            if icon
                                include ../icons/_icon-rating-5star
                    .feed-date 
                        span= username
            span
                include ../icons/_icon-more
        .feed-item-main
            .feed-image 
                img(src= thumb, alt="")
            .feed-item-content 
                p.feed-item-podcast= toptitle
                h3.feed-item-heading= title
                .feed-item-share 
                    include ../icons/_icon-share
                .feed-item-time 
                    .feed-item-day 
                        include ../icons/_icon-time-circle
                        span 11 dayes ago
                    .feed-item-long 
                        include ../icons/_icon-timer
                        span 45mins 10 Sec
                p.feed-item-decs= content
        .feed-item-footer
            .feed-actions 
                button
                    include ../icons/_icon-heart
                button
                    include ../icons/_icon-magic-star
                button
                    include ../icons/_icon-music-playlist
            +button(true)

mixin widgetHeader(title = "",url = "#")
    .widget-header  
        h3.widget-heading= title
        a.widget-view-all(href= url) View All

mixin followItem(avt = "../../images/users-follow/_user1.svg", name = "", username = "")
    .follow
        .follow-user 
            .follow-user-avatar     
                img(src= avt, alt= username)
            .follow-user-info 
                h4.follow-user-name= name
                p.follow-user-username= username            
        .follow-action 
            +button(false, "Follow")

mixin listenItem(img = "", name = "", title = "")
    .listen     
        .listen-image     
            img(src= img, alt="")
        .listen-info
            .listen-name 
                p Perspective with&nbsp;
                    span= name
            h4.listen-title= title
            .listen-meta 
                .listen-icon
                    include ../icons/_icon-play-2
                        span 156
                .listen-icon
                    include ../icons/_icon-heart
                        span 78

mixin topicItem(img = "", title = "", podcast = "") 
    .topic 
        img.topic-image(src= img, alt="")
        .topic-content 
            h4.topic-title= title
            p.topic-podcast= podcast

mixin playlistItem(img = "../images/playlist/_image1.svg", title = "UIHUT Podcast", desc = "UIHUT is a design and coding resources platform for designers, developers, and entrepreneurs.")
    .playlist-item 
        .playlist-image
            img(src= img, alt="")
        .playlist-content 
            .playlist-top 
                h3.playlist-title= title
                span.playlist-date Created on 1 day ago
            .playlist-desc= desc
            .playlist-bottom
                .playlist-episodes
                    each item in ["../../images/playlist-icon/_img1.svg","../../images/playlist-icon/_img2.svg","../../images/playlist-icon/_img3.svg","../../images/playlist-icon/_img4.svg"]
                        img.playlist-episode-image.playlist-episode-item(src= item, alt="")
                    .playlist-episode-number.playlist-episode-item 41+
                .playlist-likes
                    include ../icons/_icon-heart-fill
                    span.playlist-likes-count 1.5k

mixin thumbnailItem
    .thumbnail-item 
        .thumbnail-item-block
            img(src= "../../images/trending/_img-block.svg", alt="block")
        .thumbnail-item-content 
            h2.thumbnail-item-title Don't Always Win | LifeSpring
            span.thumbnail-item-desc Podcast Episode - 1
            span.thumbnail-item-author-name Yahia Md Amin (Chairman - LifeSpring Limited )
            button.button-thumbnail 
                include ../icons/_icon-play-button
                span Play Now
        .thumbnail-item-image 
            img(src= "../../images/trending/_img1.svg", alt="microphone")
        

mixin buttonNone(text)
    button.trending--button.button-none
        span= text

mixin HeaderItem(title= "", desc= "", text= "")
    .normal-header
        .normal-header-left 
            h1.normal-heading= title
            p.normal-heading-desc= desc
        .normal-header-right
            button.normal-header-btn 
                span.normal-header-btn-text= text
                include ../icons/_icon-cheveron

mixin TrendingPageItem(url = "", title = "", desc = "", avt = "", name = "", username = "", trackicon = "", trackinfo = "")
    .trendingpage-item 
        .trendingpage-item-image 
            img(src= url, alt="")
        .trendingpage-item-content 
            h3.trendingpage-item-title= title 
            p.trendingpage-item-desc= desc
            .trendingpage-item-date 
                .trendingpage-item-info 
                    img(src="../../images/trendingpage-item/_ellipse1.svg", alt="ellipse1")
                    span 1.2k Played
                .trendingpage-item-info 
                    img(src="../../images/trendingpage-item/_ellipse2.svg", alt="ellipse2")
                    span 1 week ago
            .trendingpage-item-user 
                .trendingpage-user-avatar 
                    img(src= avt, alt="")
                .trendingpage-user-info 
                    h4.trendingpage-user-name= name
                    span.trendingpage-user-username= username
            .trendingpage-item-track 
                a.trendingpage-item-track-icon(href="https://www.facebook.com/hldaithangg/")
                    img(src= trackicon, alt="")
                .trendingpage-item-track-info
                    img(src= trackinfo, alt="")
                    span 5:59
        .trendingpage-item-action 
            a.trendingpage-item-icon-share(href="https://www.facebook.com/hldaithangg/")
                img(src="../../images/trendingpage-item/_icon-share.svg", alt="")
            a.trendingpage-item-icon-heart(href="#")
                img(src="../../images/trendingpage-item/_icon-heart.svg", alt="")
        a.trendingpage-item-more(href="https://www.facebook.com/hldaithangg/")
            include ../icons/_icon-more
